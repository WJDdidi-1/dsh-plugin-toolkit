{
  "name": "not-shipped",
  "version": "1.0.0",
  "description": "declares files without the client bundle",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    "./client": "./client.js"
  }
}
